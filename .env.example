# Скопируй в .env и подставь свои значения (Dashboard -> Settings -> API).
VITE_SUPABASE_URL=https://<твой-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_ADMIN_USERNAME=<твой-ник-владельца>

# Для локального запуска архиватора (scripts/archive_history.mjs), необязательно:
# SUPABASE_URL=https://<твой-project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>
